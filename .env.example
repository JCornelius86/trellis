# Copy this file to .env (which Git ignores) and fill it in.
# Tokens stay in the local service. They are never sent to the browser.

# GitHub: a personal access token.
#   Fine-grained: Metadata (read) + Actions, Contents, Issues, Pull requests (read and write) on the one repo.
#   Classic: the "repo" scope.
GITHUB_TOKEN=
# The repository Trellis works with, as owner/name.
GITHUB_REPO=

# Figma: a personal access token with read access to file content, versions, and comments.
FIGMA_TOKEN=
# The key from your project file's URL: figma.com/design/<THIS PART>/Name
FIGMA_FILE_KEY=

# Optional. Port for the local service (default 8787).
# TRELLIS_PORT=8787
