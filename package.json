{
  "name": "trellis",
  "private": true,
  "version": "0.1.0",
  "description": "A lightweight hub for design-led, AI-assisted prototyping.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/*", "apps/*", "demo"],
  "scripts": {
    "start": "concurrently -k -n service,web -c blue,cyan \"npm run dev -w @trellis/service\" \"npm run dev -w @trellis/web\"",
    "demo": "npm run demo -w @trellis/web",
    "build": "npm run build -w @trellis/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
